{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build fluidSim",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",

                "src/main.cpp",
                "src/Window.cpp",
                "src/Fluid.cpp",
                "src/Camera.cpp",
                "src/Renderer.cpp",
                "src/Shader.cpp",
                "src/Mesh.cpp",
                "../Common/src/glad.c",

                "-I../Common/include",

                "-L../Common/lib",

                "-lglfw3dll",
                "-lopengl32",
                "-lgdi32",

                "-o",
                "output/main.exe",
                "-mwindows"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}